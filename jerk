-- Jerk Animation Tool for Roblox
-- Place this in StarterPlayer > StarterCharacterScripts or ServerScriptService

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

-- Configuration
local JERK_INTENSITY = 2.5 -- How intense the shake is
local JERK_SPEED = 0.08 -- How fast each jerk happens (lower = faster)
local JERK_ROTATIONS = true -- Enable rotation jerking

local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

local isJerking = false
local originalCFrame = humanoidRootPart.CFrame

-- Create a BodyGyro for rotation control (optional)
local bodyGyro = Instance.new("BodyGyro")
bodyGyro.MaxTorque = Vector3.new(0, 0, 0)
bodyGyro.P = 3000
bodyGyro.Parent = humanoidRootPart

-- Jerk function
local function startJerk()
    isJerking = true
    
    while isJerking do
        -- Random offset for position
        local randomX = math.random(-100, 100) / 100 * JERK_INTENSITY
        local randomY = math.random(-100, 100) / 100 * JERK_INTENSITY
        local randomZ = math.random(-100, 100) / 100 * JERK_INTENSITY
        
        -- Random rotation
        local randomRotX = math.random(-30, 30)
        local randomRotY = math.random(-30, 30)
        local randomRotZ = math.random(-30, 30)
        
        -- Create offset CFrame
        local offsetCFrame = CFrame.new(randomX, randomY, randomZ)
        local rotationCFrame = CFrame.Angles(
            math.rad(randomRotX),
            math.rad(randomRotY),
            math.rad(randomRotZ)
        )
        
        -- Apply the jerk
        local targetCFrame = humanoidRootPart.CFrame * offsetCFrame
        
        if JERK_ROTATIONS then
            targetCFrame = targetCFrame * rotationCFrame
        end
        
        -- Tween to create smooth jerk motion
        local tweenInfo = TweenInfo.new(
            JERK_SPEED,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        )
        
        local tween = TweenService:Create(
            humanoidRootPart,
            tweenInfo,
            {CFrame = targetCFrame}
        )
        
        tween:Play()
        tween.Completed:Wait()
        
        task.wait(0.01)
    end
end

local function stopJerk()
    isJerking = false
end

-- Toggle jerk on key press (J key)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.J then
        if not isJerking then
            print("Jerk started! Press J again to stop.")
            startJerk()
        else
            print("Jerk stopped!")
            stopJerk()
        end
    end
end)

-- Cleanup
character.Humanoid.Died:Connect(function()
    stopJerk()
end)

print("Jerk Tool loaded! Press 'J' to toggle jerking animation.")
