-- Jerk Off Tool for Roblox (Player Character Animation)
-- Place this in StarterGui as a LocalScript

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rightArm = character:WaitForChild("RightUpperArm") or character:WaitForChild("Right Arm")

-- Create ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "JerkToolUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

-- Create button
local button = Instance.new("TextButton")
button.Size = UDim2.new(0, 200, 0, 60)
button.Position = UDim2.new(0.5, -100, 0.9, -70)
button.BackgroundColor3 = Color3.fromRGB(120, 70, 200)
button.Text = "Jerk Off"
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.TextSize = 24
button.Font = Enum.Font.GothamBold
button.BorderSizePixel = 0
button.Parent = screenGui

local buttonCorner = Instance.new("UICorner")
buttonCorner.CornerRadius = UDim.new(0, 12)
buttonCorner.Parent = button

-- Make button draggable
local dragging = false
local dragInput, mousePos, framePos

button.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        mousePos = input.Position
        framePos = button.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

button.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - mousePos
        button.Position = UDim2.new(
            framePos.X.Scale,
            framePos.X.Offset + delta.X,
            framePos.Y.Scale,
            framePos.Y.Offset + delta.Y
        )
    end
end)

-- Animation variables
local isJerking = false
local motor6D = nil

-- Find the right shoulder motor
local function findRightShoulder()
    local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    if torso then
        for _, child in pairs(torso:GetChildren()) do
            if child:IsA("Motor6D") and (child.Name == "RightShoulder" or child.Name == "Right Shoulder") then
                return child
            end
        end
    end
    return nil
end

motor6D = findRightShoulder()

-- Store original C0
local originalC0 = motor6D and motor6D.C0 or CFrame.new()

-- Jerk animation function
local function doJerkMotion()
    if not motor6D then
        warn("Could not find right shoulder motor!")
        return
    end
    
    isJerking = true
    button.Text = "Stop"
    button.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
    
    while isJerking do
        -- Down stroke (fast)
        local downTween = TweenService:Create(
            motor6D,
            TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            {C0 = originalC0 * CFrame.Angles(math.rad(45), 0, 0) * CFrame.new(0, -0.3, 0)}
        )
        downTween:Play()
        downTween.Completed:Wait()
        
        if not isJerking then break end
        
        -- Up stroke (faster return)
        local upTween = TweenService:Create(
            motor6D,
            TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {C0 = originalC0 * CFrame.Angles(math.rad(-10), 0, 0)}
        )
        upTween:Play()
        upTween.Completed:Wait()
        
        task.wait(0.05)
    end
    
    -- Reset to original position
    local resetTween = TweenService:Create(
        motor6D,
        TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {C0 = originalC0}
    )
    resetTween:Play()
    
    button.Text = "Jerk Off"
    button.BackgroundColor3 = Color3.fromRGB(120, 70, 200)
end

-- Button click handler
button.MouseButton1Click:Connect(function()
    if not isJerking then
        spawn(doJerkMotion)
    else
        isJerking = false
    end
end)

-- Add hover effect
button.MouseEnter:Connect(function()
    if not isJerking then
        button.BackgroundColor3 = Color3.fromRGB(140, 90, 220)
    end
end)

button.MouseLeave:Connect(function()
    if not isJerking then
        button.BackgroundColor3 = Color3.fromRGB(120, 70, 200)
    end
end)

-- Handle character respawn
player.CharacterAdded:Connect(function(newCharacter)
    character = newCharacter
    humanoid = character:WaitForChild("Humanoid")
    rightArm = character:WaitForChild("RightUpperArm") or character:WaitForChild("Right Arm")
    motor6D = findRightShoulder()
    originalC0 = motor6D and motor6D.C0 or CFrame.new()
    isJerking = false
    button.Text = "Jerk Off"
    button.BackgroundColor3 = Color3.fromRGB(120, 70, 200)
end)

print("Jerk Tool loaded! Click the button to start.")
