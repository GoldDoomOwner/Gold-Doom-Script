-- Jerk Off UI Tool for Roblox
-- Place this in StarterGui as a LocalScript

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

-- Create ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "JerkToolUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")

-- Create main frame
local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 300, 0, 400)
mainFrame.Position = UDim2.new(0.5, -150, 0.5, -200)
mainFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
mainFrame.BorderSizePixel = 0
mainFrame.Parent = screenGui

-- Add rounded corners
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = mainFrame

-- Create character body (torso)
local torso = Instance.new("Frame")
torso.Size = UDim2.new(0, 100, 0, 120)
torso.Position = UDim2.new(0.5, -50, 0.4, 0)
torso.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
torso.BorderSizePixel = 0
torso.Parent = mainFrame

local torsoCorner = Instance.new("UICorner")
torsoCorner.CornerRadius = UDim.new(0, 8)
torsoCorner.Parent = torso

-- Create head
local head = Instance.new("Frame")
head.Size = UDim2.new(0, 60, 0, 60)
head.Position = UDim2.new(0.5, -30, -0.7, 0)
head.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
head.BorderSizePixel = 0
head.Parent = torso

local headCorner = Instance.new("UICorner")
headCorner.CornerRadius = UDim.new(1, 0)
headCorner.Parent = head

-- Create ARM (the important part!)
local arm = Instance.new("Frame")
arm.Size = UDim2.new(0, 30, 0, 80)
arm.Position = UDim2.new(1, 5, 0.2, 0)
arm.AnchorPoint = Vector2.new(0, 0)
arm.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
arm.BorderSizePixel = 0
arm.Parent = torso
arm.ZIndex = 2

local armCorner = Instance.new("UICorner")
armCorner.CornerRadius = UDim.new(0, 8)
armCorner.Parent = arm

-- Create button
local button = Instance.new("TextButton")
button.Size = UDim2.new(0, 200, 0, 50)
button.Position = UDim2.new(0.5, -100, 0.85, 0)
button.BackgroundColor3 = Color3.fromRGB(120, 70, 200)
button.Text = "Jerk Off"
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.TextSize = 20
button.Font = Enum.Font.GothamBold
button.BorderSizePixel = 0
button.Parent = mainFrame

local buttonCorner = Instance.new("UICorner")
buttonCorner.CornerRadius = UDim.new(0, 10)
buttonCorner.Parent = button

-- Animation variables
local isJerking = false
local jerkSpeed = 0.15
local jerkDistance = 50

-- Jerk animation function
local function doJerkMotion()
    isJerking = true
    button.Text = "Stop"
    button.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
    
    while isJerking do
        -- Down motion
        local downTween = TweenService:Create(
            arm,
            TweenInfo.new(jerkSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            {Position = UDim2.new(1, 5, 0.2 + jerkDistance/torso.AbsoluteSize.Y, 0)}
        )
        downTween:Play()
        downTween.Completed:Wait()
        
        if not isJerking then break end
        
        -- Up motion (faster return)
        local upTween = TweenService:Create(
            arm,
            TweenInfo.new(jerkSpeed * 0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {Position = UDim2.new(1, 5, 0.2, 0)}
        )
        upTween:Play()
        upTween.Completed:Wait()
    end
    
    -- Reset position
    arm.Position = UDim2.new(1, 5, 0.2, 0)
    button.Text = "Jerk Off"
    button.BackgroundColor3 = Color3.fromRGB(120, 70, 200)
end

-- Button click handler
button.MouseButton1Click:Connect(function()
    if not isJerking then
        spawn(doJerkMotion)
    else
        isJerking = false
    end
end)

-- Add hover effect
button.MouseEnter:Connect(function()
    if not isJerking then
        button.BackgroundColor3 = Color3.fromRGB(140, 90, 220)
    end
end)

button.MouseLeave:Connect(function()
    if not isJerking then
        button.BackgroundColor3 = Color3.fromRGB(120, 70, 200)
    end
end)

print("Jerk Tool UI loaded!")
