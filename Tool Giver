				NumberSequenceKeypoint.new(1, 1)
			})
			particles.Lifetime = NumberRange.new(1, 2)
			particles.Rate = 50
			particles.Speed = NumberRange.new(5, 10)
			particles.Parent = rootPart
			
			-- Animation loop
			local startTime = tick()
			local duration = 5
			local distance = 15
			
			while tick() - startTime < duration do
				if not rootPart or not rootPart.Parent then break end
				
				local currentAngle = (tick() - startTime) * 50
				
				-- Update each line
				for _, lineData in ipairs(compassLines) do
					local finalAngle = lineData.baseAngle + math.rad(currentAngle)
					local x = math.cos(finalAngle) * distance
					local z = math.sin(finalAngle) * distance
					
					-- Make the line face the center and stand vertically
					local lookAtCenter = CFrame.new(
						rootPart.Position + Vector3.new(x, 0, z),
						rootPart.Position
					)
					
					lineData.part.CFrame = lookAtCenter * CFrame.Angles(0, math.rad(90), 0)
				end
				
				-- Update ground
				if groundDecal.Parent then
					groundDecal.CFrame = rootPart.CFrame * CFrame.new(0, -3, 0) * CFrame.Angles(0, math.rad(currentAngle), math.rad(90))
				end
				
				task.wait()
			end
			
			-- Fade out
			particles.Enabled = false
			
			for i = 1, 20 do
				for _, lineData in ipairs(compassLines) do
					if lineData.part and lineData.part.Parent then
						lineData.part.Transparency = lineData.part.Transparency + 0.035
					end
				end
				if groundDecal and groundDecal.Parent then
					groundDecal.Transparency = groundDecal.Transparency + 0.015
				end
				task.wait(0.05)
			end
			
			-- Cleanup
			task.wait(0.5)
			if sound then sound:Destroy() end
			if compassFolder then compassFolder:Destroy() end
		end)
	end)
	
