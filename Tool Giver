					dome.Transparency = 0.3 + (0.7 * alpha)
					pointLight.Brightness = 5 * (1 - alpha)
					dome.CFrame = rootPart.CFrame
					task.wait()
				end
				
				-- Cleanup
				particles.Enabled = false
				wait(1)
				sound:Destroy()
				dome:Destroy()
			end
		end)
	end)
	
