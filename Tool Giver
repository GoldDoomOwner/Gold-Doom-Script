			if sound then sound:Destroy() end
		end)
	end)
	
	esperTool.Parent = backpack
	return esperTool
end,
}

-- Add function to create tools
function ToolModule.CreateTool(toolName, player)
	if ToolCreators[toolName] then
		return ToolCreators[toolName](player)
	else
		warn("Tool creator not found for: " .. toolName)
		return nil
	end
end

-- Add function to get all available tools
function ToolModule.GetAvailableTools()
	return Custom_PowerTools
end

-- THIS IS THE FIX: Return the module so loadstring() doesn't return nil
return ToolModule
