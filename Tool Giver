["VOID WALKER"] = function(localPlayer)
	local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
	local backpack = localPlayer.Backpack
	
	local existing = backpack:FindFirstChild("VOID WALKER") or character:FindFirstChild("VOID WALKER")
	if existing then return existing end
	
	local voidTool = Instance.new("Tool")
	voidTool.Name = "VOID WALKER"
	voidTool.RequiresHandle = false
	
	voidTool.Equipped:Connect(function()
		spawn(function()
			local char = localPlayer.Character
			if not char then return end
			
			local humanoid = char:FindFirstChild("Humanoid")
			local rootPart = char:FindFirstChild("HumanoidRootPart")
			if not humanoid or not rootPart then return end
			
			-- Sound effect
			local sound = Instance.new("Sound")
			sound.SoundId = "rbxassetid://5841166593"
			sound.Volume = 0.9
			sound.Parent = rootPart
			sound:Play()
			
			-- Become semi-transparent
			for _, part in pairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					part.Transparency = 0.5
				end
			end
			
			-- Dark void aura
			local voidAura = Instance.new("Part")
			voidAura.Name = "VoidAura"
			voidAura.Size = Vector3.new(12, 12, 12)
			voidAura.Shape = Enum.PartType.Ball
			voidAura.Transparency = 0.5
			voidAura.Color = Color3.fromRGB(20, 0, 40)
			voidAura.Material = Enum.Material.Neon
			voidAura.CanCollide = false
			voidAura.Anchored = true
			voidAura.Parent = workspace
			
			-- Dark particles
			local particles = Instance.new("ParticleEmitter")
			particles.Texture = "rbxasset://textures/particles/smoke_main.dds"
			particles.Color = ColorSequence.new(Color3.fromRGB(50, 0, 100))
			particles.Size = NumberSequence.new(1, 2)
			particles.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.3),
				NumberSequenceKeypoint.new(1, 1)
			})
			particles.Lifetime = NumberRange.new(1, 2)
			particles.Rate = 80
			particles.Speed = NumberRange.new(2, 5)
			particles.Parent = rootPart
			
			-- Create void portals
			local portals = {}
			for i = 1, 4 do
				local portal = Instance.new("Part")
				portal.Size = Vector3.new(6, 0.2, 6)
				portal.Material = Enum.Material.Neon
				portal.Color = Color3.fromRGB(100, 0, 200)
				portal.Transparency = 0.3
				portal.CanCollide = false
				portal.Anchored = true
				portal.Parent = workspace
				table.insert(portals, portal)
			end
			
			local effectActive = true
			local portalAngle = 0
			
			-- Animate aura and portals
			spawn(function()
				while effectActive and char.Parent and rootPart.Parent do
					voidAura.CFrame = rootPart.CFrame
					
					for i, portal in ipairs(portals) do
						if portal and portal.Parent then
							local offset = (i - 1) * (math.pi / 2)
							local radius = 10
							local x = math.cos(portalAngle + offset) * radius
							local z = math.sin(portalAngle + offset) * radius
							portal.CFrame = rootPart.CFrame * CFrame.new(x, -2, z) * CFrame.Angles(0, portalAngle * 2, 0)
						end
					end
					
					portalAngle = portalAngle + 0.05
					task.wait()
				end
			end)
			
			-- Void suck - pull enemies in and damage
			spawn(function()
				while effectActive and char.Parent and rootPart.Parent do
					for _, otherPlayer in pairs(game.Players:GetPlayers()) do
						if otherPlayer ~= localPlayer and otherPlayer.Character then
							local otherRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
							local otherHumanoid = otherPlayer.Character:FindFirstChild("Humanoid")
							
							if otherRoot and otherRoot.Parent and otherHumanoid then
								local distance = (rootPart.Position - otherRoot.Position).Magnitude
								if distance <= 20 and distance > 3 then
									-- Pull towards void
									local direction = (rootPart.Position - otherRoot.Position).Unit
									local bodyVelocity = Instance.new("BodyVelocity")
									bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
									bodyVelocity.Velocity = direction * 30
									bodyVelocity.Parent = otherRoot
									game:GetService("Debris"):AddItem(bodyVelocity, 0.1)
								elseif distance <= 3 then
									-- Damage when close
									otherHumanoid:TakeDamage(5)
								end
							end
						end
					end
					task.wait(0.2)
				end
			end)
			
			-- Duration
			wait(10)
			
			effectActive = false
			particles.Enabled = false
			
			-- Restore transparency
			for _, part in pairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					part.Transparency = 0
				end
			end
			
			-- Cleanup
			if voidAura then voidAura:Destroy() end
			for _, portal in ipairs(portals) do
				if portal then portal:Destroy() end
			end
			task.wait(1)
			if sound then sound:Destroy() end
		end)
	end)
	
	voidTool.Parent = backpack
	return voidTool
end,

