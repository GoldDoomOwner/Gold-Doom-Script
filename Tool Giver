local ToolModule = {}

local Custom_PowerTools = {"Awaken", "Oblivious","Titanium", "Drug Abused", "Soul Monarch", "Creation"}

-- Tool creation functions
local ToolCreators = {
	Awaken = function(localPlayer)
		local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
		local backpack = localPlayer.Backpack
		
		-- Check if already exists
		local existing = backpack:FindFirstChild("Awaken") or character:FindFirstChild("Awaken")
		if existing then return existing end
		
		local awakenTool = Instance.new("Tool")
		awakenTool.Name = "Awaken"
		awakenTool.RequiresHandle = false
		
		awakenTool.Equipped:Connect(function()
			spawn(function()
				local char = localPlayer.Character
				if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("Torso") then
					local humanoid = char.Humanoid
					local torso = char.Torso
					
					humanoid.PlatformStand = true
					
					local sound = Instance.new("Sound")
					sound.SoundId = "rbxassetid://72595772791920"
					sound.Volume = 0.5
					sound.Parent = torso
					sound:Play()
					
					local bodyVelocity = Instance.new("BodyVelocity")
					bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
					bodyVelocity.Velocity = torso.CFrame.LookVector * -50 + Vector3.new(0, -30, 0)
					bodyVelocity.Parent = torso
					
					local bodyAngularVelocity = Instance.new("BodyAngularVelocity")
					bodyAngularVelocity.MaxTorque = Vector3.new(0, 0, math.huge)
					bodyAngularVelocity.AngularVelocity = Vector3.new(0, 0, 10)
					bodyAngularVelocity.Parent = torso
					
					game:GetService("Debris"):AddItem(bodyVelocity, 0.5)
					game:GetService("Debris"):AddItem(bodyAngularVelocity, 0.5)
					
					wait(9)
					sound:Destroy()
					humanoid.PlatformStand = false
				end
			end)
		end)
		
		awakenTool.Parent = backpack
		return awakenTool
	end,
	
	Oblivious = function(localPlayer)
		local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
		local backpack = localPlayer.Backpack
		
		-- Check if already exists
		local existing = backpack:FindFirstChild("Oblivious") or character:FindFirstChild("Oblivious")
		if existing then return existing end
		
		local obliviousTool = Instance.new("Tool")
		obliviousTool.Name = "Oblivious"
		obliviousTool.RequiresHandle = false
		
		local hakiEnabled = false
		
		obliviousTool.Equipped:Connect(function()
			spawn(function()
				local char = localPlayer.Character
				if char and char:FindFirstChild("Humanoid") then
					local humanoid = char.Humanoid
					
					hakiEnabled = not hakiEnabled
					
					if hakiEnabled then
						spawn(function()
							while hakiEnabled do
								humanoid.WalkSpeed = 5.5
								task.wait()
							end
						end)
						
						if localPlayer:FindFirstChild("AutoRun") then
							localPlayer.AutoRun.Value = false
						end
					else
						humanoid.WalkSpeed = 32
						if localPlayer:FindFirstChild("AutoRun") then
							localPlayer.AutoRun.Value = true
						end
						hakiEnabled = false
					end
				end
			end)
		end)
		
		obliviousTool.Parent = backpack
		return obliviousTool
	end,
	
	["Drug Abused"] = function(localPlayer)
		local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
		local backpack = localPlayer.Backpack
		
		-- Check if already exists
		local existing = backpack:FindFirstChild("Drug Abused") or character:FindFirstChild("Drug Abused")
		if existing then return existing end
		
		local drugTool = Instance.new("Tool")
		drugTool.Name = "Drug Abused"
		drugTool.RequiresHandle = false
		
		drugTool.Equipped:Connect(function()
			spawn(function()
				local char = localPlayer.Character
				if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
					local humanoid = char.Humanoid
					local rootPart = char.HumanoidRootPart
					
					-- Store original speed
					local originalSpeed = humanoid.WalkSpeed
					
					-- Create spinning effect
					
					-- Random speed changes for 5 seconds
					local startTime = tick()
					spawn(function()
						while tick() - startTime < 5 do
							-- Randomly switch between speed 3 and 200
							local randomSpeed = math.random(1, 2) == 1 and 3 or 200
							humanoid.WalkSpeed = randomSpeed
							task.wait(0.5) -- Change speed every 0.5 seconds
						end
						
						-- Restore original speed
						humanoid.WalkSpeed = originalSpeed
					end)
				end
			end)
		end)
		
		drugTool.Parent = backpack
		return drugTool
	end
	
	-- Add more tool creators here as needed
	-- ToolName = function(localPlayer) ... end,
}

-- Check if a tool name is valid
function ToolModule:IsValidTool(toolName)
	return table.find(Custom_PowerTools, toolName) ~= nil
end

-- Get list of available tools
function ToolModule:GetAvailableTools()
	return Custom_PowerTools
end

function ToolModule:GetTools(...)
	local toolNames = {...}
	local player = game.Players.LocalPlayer
	local foundTools = {}
	
	for _, toolName in ipairs(toolNames) do
		-- First check if it's in the valid tools list
		if not self:IsValidTool(toolName) then
			warn("Tool not in Custom_PowerTools list: " .. tostring(toolName))
			continue
		end
		
		-- Check if we have a creator for this tool
		if ToolCreators[toolName] then
			-- Create or get the tool
			local tool = ToolCreators[toolName](player)
			if tool then
				table.insert(foundTools, tool)
			end
		else
			warn("No creator implemented for tool: " .. tostring(toolName) .. " (add it to ToolCreators)")
		end
	end
	
	return foundTools
end

return ToolModule
