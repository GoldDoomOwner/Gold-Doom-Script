				while effectActive and char.Parent and rootPart.Parent do
					shadowAura.CFrame = rootPart.CFrame
					
					for i, clone in ipairs(clones) do
						if clone and clone.Parent then
							local offset = (i - 1) * (math.pi / 2)
							local radius = 6
							local x = math.cos(cloneAngle + offset) * radius
							local z = math.sin(cloneAngle + offset) * radius
							clone.CFrame = rootPart.CFrame * CFrame.new(x, 0, z) * CFrame.Angles(0, cloneAngle, 0)
