								platform.Material = Enum.Material.Glass
								platform.Color = Color3.fromRGB(150, 200, 255)
								platform.Transparency = 0.3
								platform.Parent = workspace
								
								-- Auto-destroy after 15 seconds
								game:GetService("Debris"):AddItem(platform, 15)
								
								-- Visual spawn effect
								local spawnEffect = Instance.new("Part")
								spawnEffect.Size = Vector3.new(0.5, 0.5, 0.5)
								spawnEffect.Position = platform.Position
								spawnEffect.Anchored = true
								spawnEffect.CanCollide = false
								spawnEffect.Material = Enum.Material.Neon
								spawnEffect.Color = Color3.fromRGB(255, 255, 255)
								spawnEffect.Shape = Enum.PartType.Ball
								spawnEffect.Parent = workspace
								
								spawn(function()
									for i = 1, 10 do
										spawnEffect.Size = spawnEffect.Size + Vector3.new(1, 1, 1)
										spawnEffect.Transparency = i / 10
										task.wait(0.05)
									end
									spawnEffect:Destroy()
								end)
							end
						end)
						
						-- Wait for deactivation
						repeat task.wait() until not creationActive
						
						clickConnection:Disconnect()
						
					else
						-- Clean up orbs
						for _, orb in ipairs(createdParts) do
							if orb then
								orb:Destroy()
							end
						end
						createdParts = {}
					end
				end
			end)
		end)
		
		creationTool.Parent = backpack
		return creationTool
	end,
	
	["Soul Monarch"] = function(localPlayer)
		local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
		local backpack = localPlayer.Backpack
		
		-- Check if already exists
		local existing = backpack:FindFirstChild("Soul Monarch") or character:FindFirstChild("Soul Monarch")
		if existing then return existing end
		
		local soulTool = Instance.new("Tool")
		soulTool.Name = "Soul Monarch"
		soulTool.RequiresHandle = false
		
		soulTool.Equipped:Connect(function()
			spawn(function()
				local char = localPlayer.Character
				if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
					local humanoid = char.Humanoid
					local rootPart = char.HumanoidRootPart
					
					-- Heal the player
					humanoid.Health = humanoid.MaxHealth
					
					-- Create dark purple/black aura
					local monarchAura = Instance.new("Part")
					monarchAura.Name = "MonarchAura"
					monarchAura.Size = Vector3.new(12, 12, 12)
					monarchAura.Transparency = 0.8
					monarchAura.Color = Color3.fromRGB(75, 0, 130)
					monarchAura.Material = Enum.Material.Neon
					monarchAura.CanCollide = false
					monarchAura.Anchored = true
					monarchAura.Shape = Enum.PartType.Ball
					monarchAura.Parent = workspace
					
					-- Create soul particles floating around
					local souls = {}
					for i = 1, 6 do
						local soul = Instance.new("Part")
						soul.Name = "Soul"
						soul.Size = Vector3.new(1, 1, 1)
						soul.Shape = Enum.PartType.Ball
						soul.Material = Enum.Material.Neon
						soul.Color = Color3.fromRGB(200, 150, 255)
						soul.CanCollide = false
						soul.Anchored = true
						soul.Transparency = 0.3
						soul.Parent = workspace
						table.insert(souls, soul)
					end
					
					local effectActive = true
					local soulAngle = 0
					
					-- Floating souls animation
					spawn(function()
						while effectActive and char and char.Parent and rootPart and rootPart.Parent do
							monarchAura.CFrame = rootPart.CFrame
							
							for i, soul in ipairs(souls) do
								if soul and soul.Parent then
									local offset = (i - 1) * (math.pi * 2 / 6)
									local radius = 7 + math.sin(soulAngle * 2) * 2
									local x = math.cos(soulAngle + offset) * radius
									local z = math.sin(soulAngle + offset) * radius
									local y = math.sin(soulAngle * 3 + i) * 3
									soul.CFrame = rootPart.CFrame * CFrame.new(x, y, z)
								end
							end
							
							soulAngle = soulAngle + 0.05
							task.wait()
						end
					end)
					
					-- Life steal ability - drain nearby enemies
					spawn(function()
						while effectActive and char and char.Parent and rootPart and rootPart.Parent and humanoid and humanoid.Health > 0 do
							for _, otherPlayer in pairs(game.Players:GetPlayers()) do
								if otherPlayer ~= localPlayer and otherPlayer.Character and otherPlayer.Character.Parent then
									local otherRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
									local otherHumanoid = otherPlayer.Character:FindFirstChild("Humanoid")
									
									if otherRoot and otherRoot.Parent and otherHumanoid and otherHumanoid.Health > 0 then
										local distance = (rootPart.Position - otherRoot.Position).Magnitude
										if distance <= 15 then
											-- Drain health
											local drainAmount = 3
											otherHumanoid:TakeDamage(drainAmount)
											
											-- Heal self
											humanoid.Health = math.min(humanoid.Health + drainAmount, humanoid.MaxHealth)
											
											-- Create soul drain beam effect
											local beam = Instance.new("Part")
											beam.Size = Vector3.new(0.3, 0.3, distance)
											beam.Material = Enum.Material.Neon
											beam.Color = Color3.fromRGB(150, 0, 200)
											beam.Anchored = true
											beam.CanCollide = false
											beam.CFrame = CFrame.new(rootPart.Position, otherRoot.Position) 
												* CFrame.new(0, 0, -distance / 2)
											beam.Parent = workspace
											
											spawn(function()
												for i = 1, 5 do
													beam.Transparency = i / 5
													task.wait(0.05)
												end
												if beam and beam.Parent then
													beam:Destroy()
												end
											end)
										end
									end
								end
							end
							task.wait(1)
						end
					end)
					
					-- Temporary invincibility frames
					spawn(function()
						for i = 1, 20 do
							if humanoid and humanoid.Parent and humanoid.Health > 0 then
								humanoid.Health = humanoid.MaxHealth
							end
							task.wait(0.5)
						end
					end)
					
					-- Duration
					wait(10)
					
					effectActive = false
					if monarchAura and monarchAura.Parent then
						monarchAura:Destroy()
					end
					for _, soul in ipairs(souls) do
						if soul and soul.Parent then
							soul:Destroy()
						end
					end
				end
			end)
		end)
		
		soulTool.Parent = backpack
		return soulTool
	end,
	
