AkazaDash = function(localPlayer)
	local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
	local backpack = localPlayer.Backpack
	
	-- Check if already exists
	local existing = backpack:FindFirstChild("AkazaDome") or character:FindFirstChild("AkazaDome")
	if existing then return existing end
	
	local domeTool = Instance.new("Tool")
	domeTool.Name = "Akaza Dome"
	domeTool.RequiresHandle = false
	
	domeTool.Equipped:Connect(function()
		spawn(function()
			local char = localPlayer.Character
			if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
				local humanoid = char.Humanoid
				local rootPart = char.HumanoidRootPart
				
				-- Sound effect
				local sound = Instance.new("Sound")
				sound.SoundId = "rbxassetid://5801216850" -- Impact/energy sound
				sound.Volume = 0.8
				sound.Parent = rootPart
				sound:Play()
				
				-- Create dome
				local dome = Instance.new("Part")
				dome.Name = "AkazaDome"
				dome.Shape = Enum.PartType.Ball
				dome.Material = Enum.Material.ForceField
				dome.Size = Vector3.new(20, 20, 20) -- Start small
				dome.Anchored = true
				dome.CanCollide = false
				dome.Transparency = 0.3
				dome.Color = Color3.fromRGB(255, 85, 127) -- Pink
				dome.CFrame = rootPart.CFrame
				dome.Parent = workspace
				
				-- Add glow effect
				local pointLight = Instance.new("PointLight")
				pointLight.Color = Color3.fromRGB(255, 85, 127)
				pointLight.Brightness = 5
				pointLight.Range = 30
				pointLight.Parent = dome
				
				-- Particle effects around dome
				local particles = Instance.new("ParticleEmitter")
				particles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
				particles.Color = ColorSequence.new(Color3.fromRGB(255, 85, 127))
				particles.Size = NumberSequence.new(0.3, 0.6)
				particles.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0),
					NumberSequenceKeypoint.new(1, 1)
				})
				particles.Lifetime = NumberRange.new(1, 1.5)
				particles.Rate = 50
				particles.Speed = NumberRange.new(3, 5)
				particles.SpreadAngle = Vector2.new(180, 180)
				particles.EmissionDirection = Enum.NormalId.Top
				particles.Parent = dome
				
				-- Animate dome expansion
				local targetSize = Vector3.new(30, 30, 30)
				local duration = 0.3
				local startTime = tick()
				
				while tick() - startTime < duration do
					local alpha = (tick() - startTime) / duration
					dome.Size = dome.Size:Lerp(targetSize, alpha)
					dome.CFrame = rootPart.CFrame
					task.wait()
				end
				
				-- Keep dome active
				wait(2)
				
				-- Fade out dome
				local fadeTime = 0.5
				startTime = tick()
				
				while tick() - startTime < fadeTime do
