											local drainAmount = 3
											otherHumanoid:TakeDamage(drainAmount)
											
											-- Heal self
											humanoid.Health = math.min(humanoid.Health + drainAmount, humanoid.MaxHealth)
											
											-- Create soul drain beam effect
											local beam = Instance.new("Part")
											beam.Size = Vector3.new(0.3, 0.3, distance)
											beam.Material = Enum.Material.Neon
											beam.Color = Color3.fromRGB(150, 0, 200)
											beam.Anchored = true
											beam.CanCollide = false
											beam.CFrame = CFrame.new(rootPart.Position, otherRoot.Position) 
