local ToolModule = {}

local Custom_PowerTools = {"Awaken", "Oblivious","Titanium", "Drug Abused", "Soul Monarch", "Creation", "AkazaDash", "ESPER RAGE", "GOLDEN MONARCH", "VOID WALKER", "STORM BREAKER", "CRIMSON REAPER", "CELESTIAL WRATH", "SHADOW ASSASSIN", "INFERNO KING", "FROZEN DOMAIN", "GRAVITY TITAN", "PLASMA SURGE", "TOXIC VENOM", "TIME WARP", "CRYSTAL FORTRESS", "BLOOD MOON", "DRAGON SPIRIT", "NEBULA VOID", "EARTH SHAKER", "WIND DANCER", "CHAOS BREAKER"}

-- Tool creation functions
local ToolCreators = {
["DRAGON SPIRIT"] = function(localPlayer)
	local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
	local backpack = localPlayer.Backpack
	
	local existing = backpack:FindFirstChild("DRAGON SPIRIT") or character:FindFirstChild("DRAGON SPIRIT")
	if existing then return existing end
	
	local dragonTool = Instance.new("Tool")
	dragonTool.Name = "DRAGON SPIRIT"
	dragonTool.RequiresHandle = false
	
	dragonTool.Equipped:Connect(function()
		spawn(function()
			local char = localPlayer.Character
			if not char then return end
			
			local humanoid = char:FindFirstChild("Humanoid")
			local rootPart = char:FindFirstChild("HumanoidRootPart")
			if not humanoid or not rootPart then return end
			
			local sound = Instance.new("Sound")
			sound.SoundId = "rbxassetid://6026984224"
			sound.Volume = 1
			sound.Parent = rootPart
			sound:Play()
			
			-- Speed boost
			local originalSpeed = humanoid.WalkSpeed
			humanoid.WalkSpeed = 75
			
			-- Dragon aura
			local dragonAura = Instance.new("Part")
			dragonAura.Name = "DragonAura"
			dragonAura.Size = Vector3.new(17, 17, 17)
			dragonAura.Shape = Enum.PartType.Ball
			dragonAura.Transparency = 0.75
			dragonAura.Color = Color3.fromRGB(255, 50, 0)
			dragonAura.Material = Enum.Material.Neon
			dragonAura.CanCollide = false
			dragonAura.Anchored = true
			dragonAura.Parent = workspace
			
			local fire = Instance.new("Fire")
			fire.Size = 12
			fire.Heat = 20
			fire.Parent = rootPart
			
			local particles = Instance.new("ParticleEmitter")
			particles.Texture = "rbxasset://textures/particles/smoke_main.dds"
			particles.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 100, 0)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
			})
			particles.Size = NumberSequence.new(2, 3.5)
			particles.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.4),
				NumberSequenceKeypoint.new(1, 1)
			})
			particles.Lifetime = NumberRange.new(1, 2)
			particles.Rate = 90
			particles.Speed = NumberRange.new(8, 15)
			particles.Parent = rootPart
			
			-- Dragon wings
			local wings = {}
			for side = -1, 1, 2 do
				for i = 1, 2 do
					local wing = Instance.new("Part")
					wing.Size = Vector3.new(0.5, 6, 4)
					wing.Material = Enum.Material.Neon
					wing.Color = Color3.fromRGB(255, 50, 0)
					wing.Transparency = 0.5
					wing.CanCollide = false
					wing.Anchored = true
					wing.Parent = workspace
					table.insert(wings, {part = wing, side = side, index = i})
				end
			end
			
			local effectActive = true
			local wingAngle = 0
			
			spawn(function()
				while effectActive and char.Parent and rootPart.Parent do
					dragonAura.CFrame = rootPart.CFrame
					
					for _, wingData in ipairs(wings) do
						if wingData.part and wingData.part.Parent then
							local flapOffset = math.sin(wingAngle * 4) * 0.5
							local xOffset = wingData.side * (4 + wingData.index)
							local zOffset = -wingData.index + flapOffset
							
							wingData.part.CFrame = rootPart.CFrame 
								* CFrame.new(xOffset, 1, zOffset)
								* CFrame.Angles(0, math.rad(wingData.side * 30), math.rad(wingData.side * (40 + flapOffset * 30)))
						end
					end
					
					wingAngle = wingAngle + 0.12
					task.wait()
				end
			end)
			
			-- Dragon breath attack
			spawn(function()
				while effectActive and char.Parent and rootPart.Parent do
					for _, otherPlayer in pairs(game.Players:GetPlayers()) do
						if otherPlayer ~= localPlayer and otherPlayer.Character then
							local otherRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
							local otherHumanoid = otherPlayer.Character:FindFirstChild("Humanoid")
							
							if otherRoot and otherRoot.Parent and otherHumanoid then
								local distance = (rootPart.Position - otherRoot.Position).Magnitude
								if distance <= 24 then
									otherHumanoid:TakeDamage(8)
									
									-- Fire breath effect
									local breath = Instance.new("Part")
									breath.Size = Vector3.new(4, 4, distance)
									breath.Material = Enum.Material.Neon
									breath.Color = Color3.fromRGB(255, 100, 0)
									breath.Transparency = 0.5
									breath.Anchored = true
									breath.CanCollide = false
									breath.CFrame = CFrame.new(rootPart.Position, otherRoot.Position) * CFrame.new(0, 0, -distance / 2)
									breath.Parent = workspace
									
									local breathFire = Instance.new("Fire")
									breathFire.Size = 8
									breathFire.Parent = breath
									
									spawn(function()
										for i = 1, 10 do
											breath.Transparency = 0.5 + (i / 10) * 0.5
											task.wait(0.05)
										end
										breath:Destroy()
									end)
								end
							end
						end
					end
					task.wait(1.5)
				end
			end)
			
			wait(11)
			effectActive = false
			fire.Enabled = false
			particles.Enabled = false
			humanoid.WalkSpeed = originalSpeed
			
			if dragonAura then dragonAura:Destroy() end
			for _, wingData in ipairs(wings) do
				if wingData.part then wingData.part:Destroy() end
			end
			task.wait(1)
			if fire then fire:Destroy() end
			if sound then sound:Destroy() end
		end)
	end)
	
	dragonTool.Parent = backpack
	return dragonTool
end,

